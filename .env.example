# Lakebase / Postgres connection settings
LAKEBASE_HOST=localhost
LAKEBASE_PORT=5432
LAKEBASE_DB=lakebase
LAKEBASE_USER=lakebase_user
LAKEBASE_PASSWORD=changeme

# National Weather Service API
# api.weather.gov requires no API key, but does require a descriptive User-Agent
# with contact info per their usage policy.
NWS_USER_AGENT="vector-weather-retrieval-service (mbennettlowe@gmail.com)"

# Embedding model (must match dimensionality declared in the pgvector schema)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
